<catchAll>
   <sequence name="CatchAllHandler">

      <if name="ValidaOrdemJaCadastrada">
         <condition>
            contains(ora:getFaultAsString(), 'Ordem ja cadastrada')
         </condition>

         <sequence name="IgnoraOrdemJaCadastrada">
            <!-- opcional: grava log -->
            <!-- não faz throw/rethrow -->
            <!-- fluxo continua após o scope -->
         </sequence>

         <else>
            <!-- tratamento padrão para os demais erros -->
            <!-- ex: gerar payload de erro, chamar callback, encerrar processo etc. -->
         </else>

      </if>

   </sequence>
</catchAll>
